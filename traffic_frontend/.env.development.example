# Example environment variables for local development (React)
# Copy this file to `.env.development` and adjust as needed.
# Do NOT commit your actual `.env.development` file.

# PUBLIC_INTERFACE
# Base URL of the backend API for development.
# The app resolves API base URL in this order:
# 1) REACT_APP_API_BASE
# 2) REACT_APP_BACKEND_URL
# 3) window.location.origin (same-origin/proxy)
REACT_APP_API_BASE=http://localhost:3001
